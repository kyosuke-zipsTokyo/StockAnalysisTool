# J-Quants API (https://jpx-jquants.com/) - どちらか一方を設定すればよい
# 方法A: マイページに表示されているリフレッシュトークンを直接使う(SSOログイン等でパスワードが無い場合)
JQUANTS_REFRESH_TOKEN=
# 方法B: メールアドレス/パスワードでログインする(自動でリフレッシュトークンを再取得するため更新不要)
JQUANTS_MAIL_ADDRESS=
JQUANTS_PASSWORD=

# EDINET API (https://api.edinet-fsa.go.jp/api/auth/index.aspx) - 無料・即時発行のAPIキー
EDINET_API_KEY=
